    <string name="welcome_title_1">Find what matters, fast</string>
    <string name="welcome_body_1">FindTrack listens for nearby Bluetooth devices and shows how close they are — no internet needed.</string>
    <string name="welcome_title_2">Your phone and devices, clearly apart</string>
    <string name="welcome_body_2">The blue dot is you. Green pins are your Bluetooth devices. Tap a pin to see its details.</string>
    <string name="welcome_title_3">Private and offline</string>
    <string name="welcome_body_3">Everything stays on this phone. No account, no cloud, no tracking — the app even works in airplane mode.</string>

